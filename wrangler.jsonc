/**
 * Hikmah Tutors — Cloudflare Worker (React Router v8).
 * This project uses its OWN Cloudflare account, separate from Towfique HSC. Once that account exists, put its
 * account_id below so wrangler can never deploy or touch databases on the wrong account.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hikmah-tutors",
	"account_id": "30ae03db5f3ec13f73efa08f8f6fcf47",
	"compatibility_date": "2026-10-06",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * The site's address (owner bought hikmahtutor.com, 2026-11-04; the zone is on the Hikmah account). www redirects to
	 * the bare domain in workers/app.ts. The workers.dev address stays on as a fallback until the domain is confirmed.
	 */
	"routes": [
		{ "pattern": "hikmahtutor.com", "custom_domain": true },
		{ "pattern": "www.hikmahtutor.com", "custom_domain": true }
	],
	"workers_dev": true,
	/**
	 * D1 database. Local development works without a Cloudflare account (`npm run db:migrate:local`).
	 * For production: create it on the Hikmah account (`npx wrangler d1 create hikmah`) and paste the real id here.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hikmah",
			"database_id": "581549d5-386b-4132-86bd-a12c662cf523",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Tutor photos, private: nothing here is public. R2 must be enabled once in the Hikmah Cloudflare dashboard, then
	 * `npx wrangler r2 bucket create hikmah-photos` (Terminal panel). Local dev uses a local copy automatically.
	 */
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "hikmah-photos"
		}
	]
}
