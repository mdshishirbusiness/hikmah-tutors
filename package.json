{
  "name": "hikmah-tutors",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply hikmah --local",
    "db:seed:local": "wrangler d1 execute hikmah --local --file=db/seed-local-tuitions.sql",
    "import:dry-run": "node scripts/import/dry-run.mjs",
    "import:load-local": "node scripts/import/load-local.mjs",
    "test:import": "node --test scripts/import/sheet.test.mjs scripts/import/load-sql.test.mjs scripts/import/google-auth.test.mjs",
    "db:migrate": "wrangler d1 migrations apply hikmah --remote"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.151.1"
  }
}
